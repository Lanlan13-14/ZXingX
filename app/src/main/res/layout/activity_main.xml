<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="@dimen/space_32">

        <LinearLayout
            android:id="@+id/homeContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_20"
            android:paddingTop="@dimen/space_16"
            android:paddingEnd="@dimen/space_20">

            <TextView
                android:id="@+id/tvHomeTitle"
                style="@style/TextAppearance.App.LargeTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_title" />

            <TextView
                style="@style/TextAppearance.App.SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_32"
                android:layout_marginBottom="@dimen/space_8"
                android:paddingStart="@dimen/space_4"
                android:text="@string/section_scan" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_surface_card"
                android:clipToOutline="true"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/btnMultiFormat"
                    style="@style/Widget.App.ActionRow"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="@dimen/card_icon_size"
                        android:layout_height="@dimen/card_icon_size"
                        android:background="@drawable/bg_icon_badge">

                        <ImageView
                            android:layout_width="@dimen/icon_draw_size"
                            android:layout_height="@dimen/icon_draw_size"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_scan_multi" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.App.Title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/action_multi_format" />

                        <TextView
                            style="@style/TextAppearance.App.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/action_multi_format_desc" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="@dimen/icon_draw_size"
                        android:layout_height="@dimen/icon_draw_size"
                        android:layout_gravity="center_vertical"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="64dp"
                    android:background="@color/colorSeparatorHairline" />

                <LinearLayout
                    android:id="@+id/btnQRCode"
                    style="@style/Widget.App.ActionRow"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="@dimen/card_icon_size"
                        android:layout_height="@dimen/card_icon_size"
                        android:background="@drawable/bg_icon_badge">

                        <ImageView
                            android:layout_width="@dimen/icon_draw_size"
                            android:layout_height="@dimen/icon_draw_size"
                            android:scaleType="centerInside"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_scan_qr" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.App.Title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/action_qr_code" />

                        <TextView
                            style="@style/TextAppearance.App.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/action_qr_code_desc" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="@dimen/icon_draw_size"
                        android:layout_height="@dimen/icon_draw_size"
                        android:layout_gravity="center_vertical"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="64dp"
                    android:background="@color/colorSeparatorHairline" />

                <LinearLayout
                    android:id="@+id/btnFullQRCode"
                    style="@style/Widget.App.ActionRow"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="@dimen/card_icon_size"
                        android:layout_height="@dimen/card_icon_size"
                        android:background="@drawable/bg_icon_badge">

                        <ImageView
                            android:layout_width="@dimen/icon_draw_size"
                            android:layout_height="@dimen/icon_draw_size"
                            android:scaleType="centerInside"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_scan_full" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.App.Title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/action_full_qr" />

                        <TextView
                            style="@style/TextAppearance.App.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/action_full_qr_desc" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="@dimen/icon_draw_size"
                        android:layout_height="@dimen/icon_draw_size"
                        android:layout_gravity="center_vertical"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="64dp"
                    android:background="@color/colorSeparatorHairline" />

                <LinearLayout
                    android:id="@+id/btnPickPhoto"
                    style="@style/Widget.App.ActionRow"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="@dimen/card_icon_size"
                        android:layout_height="@dimen/card_icon_size"
                        android:background="@drawable/bg_icon_badge">

                        <ImageView
                            android:layout_width="@dimen/icon_draw_size"
                            android:layout_height="@dimen/icon_draw_size"
                            android:scaleType="centerInside"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_photo" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.App.Title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/action_pick_photo" />

                        <TextView
                            style="@style/TextAppearance.App.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/action_pick_photo_desc" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="@dimen/icon_draw_size"
                        android:layout_height="@dimen/icon_draw_size"
                        android:layout_gravity="center_vertical"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/TextAppearance.App.SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_32"
                android:layout_marginBottom="@dimen/space_8"
                android:paddingStart="@dimen/space_4"
                android:text="@string/section_generate" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_surface_card"
                android:clipToOutline="true"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/btnGenerateQrCode"
                    style="@style/Widget.App.ActionRow"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="@dimen/card_icon_size"
                        android:layout_height="@dimen/card_icon_size"
                        android:background="@drawable/bg_icon_badge">

                        <ImageView
                            android:layout_width="@dimen/icon_draw_size"
                            android:layout_height="@dimen/icon_draw_size"
                            android:scaleType="centerInside"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_generate_qr" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.App.Title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/action_generate_qr" />

                        <TextView
                            style="@style/TextAppearance.App.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/action_generate_qr_desc" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="@dimen/icon_draw_size"
                        android:layout_height="@dimen/icon_draw_size"
                        android:layout_gravity="center_vertical"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="64dp"
                    android:background="@color/colorSeparatorHairline" />

                <LinearLayout
                    android:id="@+id/btnGenerateBarcode"
                    style="@style/Widget.App.ActionRow"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="@dimen/card_icon_size"
                        android:layout_height="@dimen/card_icon_size"
                        android:background="@drawable/bg_icon_badge">

                        <ImageView
                            android:layout_width="@dimen/icon_draw_size"
                            android:layout_height="@dimen/icon_draw_size"
                            android:scaleType="centerInside"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_generate_barcode" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.App.Title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/action_generate_barcode" />

                        <TextView
                            style="@style/TextAppearance.App.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/action_generate_barcode_desc" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="@dimen/icon_draw_size"
                        android:layout_height="@dimen/icon_draw_size"
                        android:layout_gravity="center_vertical"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
